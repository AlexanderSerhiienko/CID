# Database (local dev)
DATABASE_URL="postgresql://cid:cid@localhost:5433/cid?schema=public"

# Database (production — Supabase)
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Admin
ADMIN_TOKEN="dev-admin-token"

# Cron (Vercel Cron calls /api/cron/ingest with Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET="your-random-secret"

# Nominatim geocoding (free OpenStreetMap, enabled by default, set to "false" to disable)
# NOMINATIM_ENABLED="false"

# Groq AI extraction (optional — free tier at console.groq.com)
# When set, Groq refines category/severity/summary for likely risk events.
# Falls back to deterministic rules if key is missing or on any error.
# GROQ_API_KEY="gsk_..."

# Ollama (optional AI extraction — local only, not used in production)
OLLAMA_ENABLED="false"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
