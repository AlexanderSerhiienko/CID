# Database (local dev)
DATABASE_URL="postgresql://cid:cid@localhost:5433/cid?schema=public"

# Database (production — Supabase)
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Redis (local dev)
REDIS_URL="redis://localhost:6379"

# Redis (production — Upstash)
# REDIS_URL="rediss://..."

# Admin
ADMIN_TOKEN="dev-admin-token"

# Cron (Vercel Cron calls /api/cron/ingest with Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET="your-random-secret"

# Ollama (optional AI extraction)
OLLAMA_ENABLED="false"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
