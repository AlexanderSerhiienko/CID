{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "MCP Server (stdio)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mcp"],
      "autoPort": true
    },
    {
      "name": "Docker Services (PostgreSQL + Redis)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "-d"],
      "port": 5433
    }
  ]
}
